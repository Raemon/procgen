{
  "name": "procgen",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash tools/killPortThenStartDevServer.sh",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
    "start:prod": "sh -c 'if [ -n \"$DATABASE_URL\" ]; then npx prisma db push --skip-generate --accept-data-loss; fi; exec npx tsx --env-file-if-exists=.env server/index.ts'",
    "typecheck": "tsc --noEmit",
    "check:chat": "npx tsx checks/checkSpeechBubbleStore.ts && npx tsx checks/checkChatOverWebsocket.ts",
    "check:ui": "npx tsx checks/checkPersistedUiState.ts",
    "check:tooltips": "npx tsx checks/checkPanelTooltips.ts",
    "check:nodefilter": "esbuild checks/checkNodeTypeFilter.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/checkNodeTypeFilter.mjs && node dist/checkNodeTypeFilter.mjs",
    "check": "esbuild checks/checkProcgenInvariants.ts --bundle --format=esm --platform=node --log-level=error --external:typescript --outfile=dist/checks.mjs && node --test-reporter=spec dist/checks.mjs",
    "roll": "esbuild tools/rollAndRankWorlds.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/rollAndRankWorlds.mjs && node dist/rollAndRankWorlds.mjs",
    "docs:seed": "npx tsx --env-file-if-exists=.env tools/seedDocsFromDataFiles.ts",
    "pipeline:write": "bash tools/runTool.sh writePipelineDataFile",
    "chunk:load": "bash tools/runTool.sh probeChunkDrawLoad",
    "tiles:detail": "bash tools/runTool.sh probeTileDetail",
    "items:draws": "bash tools/runTool.sh probeItemAndCreatureDraws",
    "billboards:preview": "bash tools/runTool.sh renderBillboardSheet",
    "characters:preview": "bash tools/runTool.sh renderCharacterSheet",
    "perf": "bash tools/runTool.sh benchmarkWorldPerf",
    "dwarf:preview": "bash tools/runTool.sh renderDwarfPortrait",
    "dwarf:sheet": "bash tools/runTool.sh renderDwarfSheet",
    "textures:bake": "bash tools/runTool.sh bakeTileTextures",
    "textures:sheet": "bash tools/runTool.sh renderTextureContactSheet",
    "tiles:write": "bash tools/runTool.sh writeTilesetDataFile",
    "pieces:write": "bash tools/runTool.sh writePiecesDataFile",
    "cultures:write": "bash tools/runTool.sh writeCulturesDataFile",
    "assets:generate": "esbuild tools/generateRandomAssets.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/generateRandomAssets.mjs && node dist/generateRandomAssets.mjs",
    "village:probe": "bash tools/runTool.sh probeVillageSnapshot",
    "village:overhead": "bash tools/runTool.sh renderVillageOverhead",
    "view:render": "NODE_PATH=\"$(npm root -g)\" npx tsx tools/agentView/renderWorldView.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "tsx": "^4.23.9",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.21.5",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
