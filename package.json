{
  "name": "procgen",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/killPortThenStartDevServer.sh",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "start:prod": "sh -c 'if [ -n \"$DATABASE_URL\" ]; then npx prisma db push --skip-generate --accept-data-loss; fi; exec npx tsx server/index.ts'",
    "typecheck": "tsc --noEmit",
    "check:chat": "npx tsx scripts/checkSpeechBubbleStore.ts && npx tsx scripts/checkChatOverWebsocket.ts",
    "check:ui": "npx tsx scripts/checkPersistedUiState.ts",
    "check:tooltips": "npx tsx scripts/checkPanelTooltips.ts",
    "check:nodefilter": "esbuild scripts/checkNodeTypeFilter.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "check": "esbuild scripts/checkProcgenInvariants.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "roll": "esbuild scripts/rollAndRankWorlds.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/rollAndRankWorlds.mjs && node dist/rollAndRankWorlds.mjs",
    "tiles:write": "esbuild scripts/writeTilesetDataFile.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "pipeline:write": "esbuild scripts/writePipelineDataFile.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "tiles:preview": "esbuild scripts/renderTilesetPreview.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "characters:preview": "esbuild scripts/renderCharacterSheet.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "perf": "esbuild scripts/benchmarkWorldPerf.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "dwarf:preview": "esbuild scripts/renderDwarfPortrait.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "dwarf:sheet": "esbuild scripts/renderDwarfSheet.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module",
    "creatures:write": "esbuild scripts/writeCreaturesDataFile.ts --bundle --format=esm --platform=node --log-level=error | node --input-type=module"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "tsx": "^4.23.9",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
