{
  "name": "procgen",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/killPortThenStartDevServer.sh",
    "server": "tsx watch --env-file-if-exists=.env server.ts",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/infrastructure/server/worldBuilds/worldBuildWorker.ts --bundle --platform=node --format=esm --packages=external --log-level=error --outfile=dist/workers/worldBuildWorker.mjs",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server.ts",
    "start:prod": "sh -c 'if [ -n \"$DATABASE_URL\" ]; then npx prisma db push --skip-generate --accept-data-loss; fi; exec npm start'",
    "typecheck": "tsc --noEmit",
    "check:sokoban2": "esbuild src/worlds/sokoban2/__tests__/referees/worldSmoke.ts --bundle --platform=node --format=esm --log-level=error --outfile=dist/referees/sokoban2World.mjs && node dist/referees/sokoban2World.mjs",
    "check:sokoban2:play": "esbuild src/worlds/sokoban2/__tests__/referees/smoke.ts --bundle --platform=node --format=esm --log-level=error --outfile=dist/referees/sokoban2Play.mjs && node dist/referees/sokoban2Play.mjs",
    "check:sokoban2:puzzle": "esbuild src/worlds/sokoban2/__tests__/referees/puzzleSmoke.ts --bundle --platform=node --format=esm --log-level=error --outfile=dist/referees/sokoban2Puzzle.mjs && node dist/referees/sokoban2Puzzle.mjs",
    "check:sokoban2:quality": "esbuild src/worlds/sokoban2/__tests__/referees/qualitySmoke.ts --bundle --platform=node --format=esm --log-level=error --outfile=dist/referees/sokoban2Quality.mjs && node dist/referees/sokoban2Quality.mjs",
    "check:sokoban2:reverse": "esbuild src/worlds/sokoban2/__tests__/referees/reverseSmoke.ts --bundle --platform=node --format=esm --log-level=error --outfile=dist/referees/sokoban2Reverse.mjs && node dist/referees/sokoban2Reverse.mjs",
    "deploy:wait": "bash scripts/waitForProductionCommit.sh",
    "test": "node --import tsx --test --test-reporter=spec src/features/app-shell/__tests__/app.test.ts",
    "roll": "esbuild scripts/rollAndRankWorlds.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/rollAndRankWorlds.mjs && node dist/rollAndRankWorlds.mjs",
    "selfplay": "esbuild scripts/trainWalkingSimWorlds.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/trainWalkingSimWorlds.mjs && node dist/trainWalkingSimWorlds.mjs",
    "walk:rank": "esbuild scripts/rankWalkingSimWorlds.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/rankWalkingSimWorlds.mjs && node dist/rankWalkingSimWorlds.mjs",
    "walk:calibrate": "esbuild scripts/calibrateWalkingSimBands.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/calibrateWalkingSimBands.mjs && node dist/calibrateWalkingSimBands.mjs",
    "chunk:load": "bash scripts/runTool.sh probeChunkDrawLoad",
    "tiles:detail": "bash scripts/runTool.sh probeTileDetail",
    "items:draws": "bash scripts/runTool.sh probeItemAndCreatureDraws",
    "billboards:preview": "bash scripts/runTool.sh renderBillboardSheet",
    "fixtures:preview": "bash scripts/runTool.sh renderPuzzleFixtureSheet",
    "characters:preview": "bash scripts/runTool.sh renderCharacterSheet",
    "perf": "bash scripts/runTool.sh benchmarkWorldPerf",
    "dwarf:preview": "bash scripts/runTool.sh renderDwarfPortrait",
    "dwarf:sheet": "bash scripts/runTool.sh renderDwarfSheet",
    "textures:bake": "bash scripts/runTool.sh bakeTileTextures",
    "textures:sheet": "bash scripts/runTool.sh renderTextureContactSheet",
    "assets:generate": "esbuild scripts/generateRandomAssets.ts --bundle --format=esm --platform=node --log-level=error --outfile=dist/generateRandomAssets.mjs && node dist/generateRandomAssets.mjs",
    "features:probe": "bash scripts/runTool.sh probeWorldFeatures",
    "labyrinth:probe": "bash scripts/runTool.sh probeLabyrinthChunks",
    "village:probe": "bash scripts/runTool.sh probeVillageSnapshot",
    "volcanic:probe": "bash scripts/runTool.sh probeVolcanicWorld",
    "village:overhead": "bash scripts/runTool.sh renderVillageOverhead",
    "view:render": "NODE_PATH=\"$(npm root -g)\" npx tsx scripts/agentView/renderWorldView.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "tsx": "^4.23.9",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "@types/ws": "^8.18.1",
    "esbuild": "0.21.5",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
